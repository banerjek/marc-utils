	localtagfile="${fileroot}_localfields.tsv"

	rm -f "${fixedfile}" "${rankedfile}" "${mapfile}" "${localtagfile}" "${fileroot}_best_records.tsv"

	pv "${f}" |awk -v RS=$'\x1d' 'END{printf "%d", NR/5 + 1 > "tmpnum";printf "%d", NR > "tmptotal"}' 
	numrecs=$(cat tmpnum)
	rm tmpnum

	printf "Separating into 5 temporary files containing approximately %s records\n\n", ${numrecs}

	cat "${f}" | tr '\n' ' ' |awk -v RS=$'\x1d' -v ORS=$'\x1d' -v filecounter=1 -v NUMRECS=${numrecs} '{if (NR % NUMRECS == 0){filecounter++};outfile=sprintf("tmp_in_%d.mrc", filecounter);print $0 > outfile;if (NR % 10000 == 0){ printf "Records: "NR"\r"}}' 
	echo "Records: $(cat tmptotal)"
	rm -f tmptotal

	echo "Building work IDs, id maps, local fields, and MARC files"

	for i in {1..5};do 
		infile="tmp_in_"${i}".mrc"
		awk -v RS=$'\x1d' -v ORS=$'\x1d' -v SFS=$'\x1f' -v FS=$'\x1e' -v OFS=$'\x1e' -v SEQ=${i} -b -f tmp_addworkids "${infile}" &
	done	
