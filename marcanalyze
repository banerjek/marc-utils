function extract_tags() {
	for (d_iter=1; d_iter<=directory_length; d_iter=d_iter+12) {
		marc_tag = substr(directory, d_iter, 3)
		field_length = substr(directory, d_iter + 3, 4) + 0
		starting_pos = substr(directory, d_iter + 7, 5) + 0

		switch(marc_tag) {
			case "001":
				getfixedfield()
				tag001 = fixedfield
				break
			case "007":
				qScore += 5
				getfixedfield()
				tag007 = fixedfield
				if (substr(tag007, 1, 2) == "cr"){ format="e"}
				break
			case "008":
				gooddate = 0
				getfixedfield()

				tag008 = fixedfield
	
				date008 = substr(tag008, 12, 4)
				if (date008 ~ /[12][0-9][0-9][0-9]/) {
					gooddate = 1
					pubdate = date008"_"
				}
	
				if (gooddate == 0){ 
					date008 = substr(tag008, 8, 4)
					pubStatus = substr(tag008, 7, 1)

					if (date008 ~ /[12][0-9][0-9][0-9]/ && pubStatus != "r") {
						gooddate = 1
						pubdate = date008"_"
					}
				}
				break
			case "009":
				getfixedfield()
				tag009 = fixedfield
				break
			case "010":
			case "020":
			case "022":
				if (maxid <=3 ){qScore += 5; maxid++ }
				break
			case "042":
				qScore += 5
				break
			case "050":
				if (maxcall <=3 ){qScore += 5; maxcall++ }
				getvarfield()
				tag050 = substr(varfield, 4)
				gsub(/\037./, " ", tag050)
				break
			case "060":
				if (maxcall <=3 ){qScore += 5; maxcall++ }
				break
			case "070":
				if (maxcall <=3 ){qScore += 5; maxcall++ }
				break
			case "082":
				if (maxcall <=3 ){qScore += 5; maxcall++ }
				break
			case "086":
				if (maxcall <=3 ){qScore += 5; maxcall++ }
				getvarfield()
				tag086 = varfield
				tag086 = extract_subfield("a")
				gsub(/[[:punct:][:space:]]/, "", tag086)
				tag086 = tag086"_"
				break
			case "090":
				getvarfield()
				tag090 = substr(varfield, 4)
				gsub(/\037./, " ", tag090)
				break
			case "100":
			case "110":
			case "111":
			case "130":
			case "240":
				qScore += 5
				getvarfield()
				tagme = extract_subfield("a")
				gsub(/[[:punct:][:space:]]/, "", tagme)
				if (leader7 == "s") {
					tagme = tolower(substr(tagme, 1, 60)"_")
				} else {
					tagme = tolower(substr(tagme, 1, 5)"_")
				}
				qScore += 7

				if (match(varfield, subfield_not_a)) { qScore += 3 }	
				
				break
			case "245":
				getvarfield()
				tag245 = varfield
	
				gsub(/&/, "", tag245)
				tag245a = extract_subfield("a")
				titleProper = substr(tag245a, 1, 60)
				sub(/[*[[:punct:][:space:]]]*$/, "", titleProper)
				tag245b = extract_subfield("b")
				tag245h = extract_subfield("h")
				tag245p = extract_subfield("p")
				tag245n = extract_subfield("n")
				sub(/^([Aa] |[Aa]n |[Tt]he )/, "", tag245a)
	
				if (index(245h, "electronic")){ format="e"}
			
				tag245 = tag245a""tag245b
				tag245p = substr(tag245p, 1, 10)""substr(tag245n, 1, 10)
				if (match(tag245, /^[A-Z]+$/)) { 
					qScore -= 10
					if (highencoding == 1){ qScore -= 5 }
				}

				if (match(varfield, subfield_not_a, arr245)) { qScore += 5 }	
			
				gsub(/[[:punct:][:space:]]/, "", tag245)
				tag245 = substr(tag245, 1, 100)""tag245p
				tag245 = tolower(tag245"_")
				break
			case "250":
				getvarfield()
	
				tag250 = extract_subfield("a")
				tag250 = tolower(tag250)
				check250 = longest_number(tag250)
	
				if (! check250 ~ /[1-9]/) {
					sub(/fir/, "1", tag250)
					sub(/sec/, "2", tag250)
					sub(/thi/, "3", tag250)
					sub(/fou/, "4", tag250)
					sub(/fif/, "5", tag250)
					sub(/six/, "6", tag250)
					sub(/sev/, "7", tag250)
					sub(/eig/, "8", tag250)
					sub(/nin/, "9", tag250)
					sub(/ten/, "10", tag250)
				} else {
					tag250 = check250
				}
				gsub(/[[:punct:][:space:]]/, "", tag250)
				qScore += 5
				tag250 = tag250"_"
				break
			case "260":
				getvarfield()
				tag260 = varfield
				tag260b = extract_subfield("b")
	
				gsub(/[[:punct:][:space:]]/, "", tag260b)

				if (length(tag260b) > 3 && match(tag260b, /[a-z]/)) { qScore += 5 }

				tag260b = tolower(substr(tag260b, 1, 5))
	
				if (gooddate == 0) {
					tag260c = extract_subfield("c")
					date260 = gensub(validdate, "\\\1", "1", tag260c)
	
					if (date260 ~ /[0-9][0-9][0-9][0-9]/) { 
						gsub(/^[0-9]/, "", date260)
						date260 = substr(date260, 1, 4)
						gooddate = 2 
						pubdate = date260"_"
					}
				}
				break
			case "264":
				getvarfield()
				tag264 = varfield
	
				tag264b = extract_subfield("b")
	
				publisher = tag264b
	
				gsub(/[[:punct:][:space:]]/, "", tag264b)
				if (length(tag264b) > 3 && match(tag264b, /[a-z]/)) { qScore += 5 }

				tag264b = tolower(substr(tag264b, 1, 5))
	
				if (gooddate != 1 ) {
					tag264c = extract_subfield("c")
					tag264c = gensub(validdate, "\\\1", "1", tag264c)
	
					if (tag264c ~ /[0-9][0-9][0-9][0-9]/) { 
						gsub(/^[0-9]/, "", tag264c)
						tag264c = substr(tag264c, 1, 4)
						pubdate = tag264c
						pubdate = pubdate"_"
					}
				} 
				break
			case "300":
				getvarfield()
				tag300 = varfield
				pagination = tag300
				gsub(subfield_regex, " ", pagination)
				tag300 = extract_subfield("a")
				tag300 = longest_number(tag300)"_"
				break
			case "362":
				if (maxseq <=2 ){qScore += 5; maxseq++ }
				break
			case "505":
			case "520":
				if (maxnotes <=2 ){qScore += 5; maxnotes++ }
				break;
			case "700":
			case "710":
			case "711":
				if (maxname <=3 ){qScore += 5; maxname++ }
				break;
			case "490":
			case "780":
			case "785":
			case "800":
			case "810":
			case "811":
			case "830":
				if (maxseries <=3 ){qScore += 5; maxseries++ }
				break;
			case "880":
				getvarfield()
				tag880 = varfield
				subtag=substr(tag880, 3, 3)
	
				switch(subtag) {
					case "100":
					case "110":
					case "111":
					case "130":
						tagme = extract_subfield("a")
						gsub(/[[:punct:][:space:]]/, "", tagme)
						tagme = tagme"_"
						break
					case "245":
						sub(/ =.*/, "", varfield) ## remove parallel entry
						tag245a =  extract_subfield("a")
						tag245b =  extract_subfield("b")
						tag245p =  extract_subfield("p")
						tag245 = tag245a""tag245b""tag245p
						gsub(/[[:punct:][:space:]]/, "", tag245)
						tag245 = tag245"_"
						#tag245 = substr(tag245, 1, 70)"_"
						break
					default:
						break	
				}
				break
			case "907":
				getvarfield()
				tag907a = extract_subfield("a")
				break
			case "999":
				getvarfield()
				tag999i = extract_subfield("i")
				if (tag999i !~ /^[a-f0-9]*-[a-f0-9]*-[a-f0-9]*-[a-f0-9]*-[a-f0-9]*$/) { tag999i = "" }
				break
			default:
				break
		}
	}
}

function extract_local_fields() {
	for (d_iter=1; d_iter<=directory_length; d_iter=d_iter+12) {
		marc_tag = substr(directory, d_iter, 3)
		field_length = substr(directory, d_iter + 3, 4) + 0
		starting_pos = substr(directory, d_iter + 7, 5) + 0

		switch(marc_tag) {
			case "590":
			case "690":
				extract_local_field()
				break
			default:
				break
		}
	}
