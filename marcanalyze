	echo "Finalizing tag file"
	pv tmp_tag_*.tsv >> "${localtagfile}"
	echo "Finalizing unranked MARC file with merge IDs"
	pv tmp_out_*.mrc >> "${fixedfile}"

	rm -f tmp_in_*.mrc tmp_out_*.mrc tmp_tag_*.tsv workId_map_*
	echo "Unranked MARC and map files have been output to ${fixedfile} and ${mapfile}"
	echo "Local tags have been output to ${localtagfile}"
done
