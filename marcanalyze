echo -e "${awkscript}" > tmp_addworkids
chmod 700 tmp_addworkids

for f in ${filelist[@]};do
	echo "Splitting ${f} to speed processing. Determining number of records."

	fileroot=$(echo "${f}" | sed 's/\.....\?$//')
	fixedfile="${fileroot}_with009_unranked.mrc"
	extractedfile="${fileroot}_with009_unranked_matched.mrc"
	unmatchedfile="${fileroot}_with009_unranked_not-matched.mrc"
