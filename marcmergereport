#!/usr/bin/bash
# Usage: ./run_merge.sh file1.tsv [file2.tsv ...] > out.tsv
# Input: tab-delimited with a header row. Columns must be in this order:
#   mergeId  qScore  001  title  [any further columns, e.g. 999i 907a]

outfile=duplicate_records_report.tsv
mapfile=duplicate_records_map.tsv

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 file1 [file2 ...]" >&2
    exit 1
fi

missing=0
for f in "$@"; do
    if [ ! -f "$f" ] || [ ! -r "$f" ]; then
        echo "Error: file not found or not readable: $f" >&2
        missing=1
    fi
done

if [ "$missing" -ne 0 ]; then
    exit 1
fi

echo "Checking $# input file(s): OK" >&2

# ... any pre-processing goes here ...

awk -v mapfile="${mapfile}" '
function msg(s)  { printf "%s\n", s > "/dev/stderr" }
# in-place counter: label, current number (rewrites the same line via \r)
function tick(label, n) { printf "\r  %s %d", label, n > "/dev/stderr" }
# finish an in-place counter line with a final newline
function done(label, n) { printf "\r  %s %d\n", label, n > "/dev/stderr" }

BEGIN { FS = OFS = "\t"; step = 1000 }

# Header row: check the first four column names, remember the extra ones
FNR == 1 {
    # close off the counter of the previous file, if any
    if (nf > 0) done("rows read:", frows)
    frows = 0
    nf++; fname[nf] = FILENAME
    msg("Reading " FILENAME)
    if ($1 != "mergeId" || $2 != "qScore" || $3 != "001" || $4 != "title") {
        print "Error: header must start with mergeId, qScore, 001, title in " FILENAME > "/dev/stderr"
        bad = 1; exit 1
    }
    if (nf == 1) {
        hn = NF
        for (i = 4; i <= hn; i++) hdr = hdr (i > 4 ? OFS : "") $i
    }
    next
}

{
    total++; frows++
    if (frows % step == 0) tick("rows read:", frows)

    id = $1
    q  = $2 + 0
    k  = id SUBSEP nf

    # remember first-seen order of mergeIds for stable output
    if (!(id in seen)) { seen[id] = 1; order[++n] = id }

    # count distinct files in which this mergeId appears
    if (!(k in cnt)) nfiles[id]++

    # keep every 001 for this (mergeId, file), in the order encountered
    cnt[k]++
    val[k, cnt[k]] = $3

    # overall best per mergeId; strict > means first encountered wins ties
    if (!(id in bq) || q > bq[id]) {
        rest = ""
        for (i = 4; i <= hn; i++) rest = rest (i > 4 ? OFS : "") $i
        bq[id] = q; brest[id] = rest; bfile[id] = nf; bpos[id] = cnt[k]
    }
}

END {
    if (bad) exit 1
    if (nf > 0) done("rows read:", frows)
    msg("Read " total " data rows from " nf " file(s); " n " distinct mergeIds")
    msg("Building merge report and map...")

    # header row
    printf "mergeId" OFS "%s", hdr
    for (f = 1; f <= nf; f++) printf OFS fname[f]
    printf "\n"

    # map file header (machine-readable companion to the report)
    print "not_best_001", "not_best_file", "best_001", "best_file" > mapfile

    for (i = 1; i <= n; i++) {
        if (i % step == 0) tick("mergeIds processed:", i)
        id = order[i]

        # several files: must appear in 2+ files
        # single file: must appear on 2+ rows
        if (nf > 1) { if (nfiles[id] < 2) continue }
        else if (cnt[id SUBSEP 1] < 2) continue

        printf "%s" OFS "%s", id, brest[id]
        for (f = 1; f <= nf; f++) {
            k = id SUBSEP f
            kb = id SUBSEP bfile[id]
            v = ""
            # best 001 goes first, starred
            if (f == bfile[id]) v = "*" val[k, bpos[id]] "*"
            # then all the others, in original order
            for (j = 1; j <= cnt[k]; j++) {
                if (f == bfile[id] && j == bpos[id]) continue
                # one map line per not-best 001
                print val[k, j], fname[f], val[kb, bpos[id]], fname[bfile[id]] > mapfile
                v = (v == "") ? val[k, j] : v ";" val[k, j]
            }
            printf OFS "%s", v
        }
        printf "\n"
        kept++
    }
    done("mergeIds processed:", n)
    msg("Duplicates found: " kept+0 " mergeIds written to report")
}
' "$@" |cut -f2- > ${outfile}
rc=${PIPESTATUS[0]}

if [ "$rc" -ne 0 ]; then
    echo "Error: merge failed (awk exit status $rc)" >&2
    exit "$rc"
fi

echo "Merge report has been sent to ${outfile}"
echo "Merge map has been sent to ${mapfile}"

