#!/usr/bin/bash
export LC_ALL=C.UTF-8

infile="${1}"
outfile="${infile%.*}"

# -------------------------------------------------
# INPUT ENCODING: convert whatever we were given to clean UTF-8.
# Usage: tsv2marc FILE [ENCODING]   (2nd argument forces the input encoding,
# e.g. gb18030, big5, windows-1252; otherwise it is detected)
# The original file is left untouched.
# -------------------------------------------------
FORCE_ENC="${2:-}"

# detect_encoding FILE  -> prints an iconv-compatible encoding name.
# Order: forced override (FORCE_ENC) -> BOM -> UTF-16 without BOM (NUL bytes)
# -> valid UTF-8 -> uchardet (if installed) -> heuristic (CJK vs Western).
detect_encoding() {
  local f="$1" bom g enc total dropped pairs le be cjk=0
  if [[ -n "${FORCE_ENC:-}" ]]; then echo "${FORCE_ENC}"; return; fi

  bom=$(head -c3 "$f" | od -An -tx1 | tr -d ' \n')
  case "$bom" in
    fffe*|feff*) echo utf-16; return ;;      # "utf-16" reads the BOM itself
    efbbbf)      echo utf-8;  return ;;
  esac

  # UTF-16 without a BOM: lots of NUL bytes, all at odd (LE) or even (BE) offsets
  read -r le be < <(head -c 4096 "$f" | od -An -v -tx1 -w2 |
    awk '$2=="00"{l++} $1=="00"{b++} END{print l+0, b+0}')
  if (( le > 4 && le > be * 4 )); then echo utf-16le; return; fi
  if (( be > 4 && be > le * 4 )); then echo utf-16be; return; fi

  if iconv -f utf-8 -t utf-8 "$f" >/dev/null 2>&1; then echo utf-8; return; fi

  # Mostly UTF-8 with a few stray bad bytes: still UTF-8 (the bad bytes get
  # dropped on conversion) rather than misreading the whole file as legacy.
  total=$(head -c 1000000 "$f" | LC_ALL=C grep -aoP '[\x80-\xff]' | wc -l)
  dropped=$(( $(head -c 1000000 "$f" | wc -c) - $(head -c 1000000 "$f" | iconv -c -f utf-8 -t utf-8 2>/dev/null | wc -c) ))
  if (( total > 0 && dropped * 20 < total )); then echo utf-8; return; fi

  if command -v uchardet >/dev/null 2>&1; then
    enc=$(uchardet "$f" 2>/dev/null)
    case "${enc,,}" in ""|unknown|ascii*) ;; *)
      if iconv -f "$enc" -t utf-8 "$f" >/dev/null 2>&1; then echo "$enc"; return; fi ;;
    esac
  fi

  # Heuristic: in GBK/Big5/Shift-JIS text high bytes come in adjacent pairs;
  # in Latin-1/cp1252 text, accented letters are mostly isolated.
  pairs=$(head -c 1000000 "$f" | LC_ALL=C grep -aoP '[\x80-\xff]{2}' | wc -l)
  (( total > 0 && pairs * 2 * 10 >= total * 6 )) && cjk=1

  if (( cjk )); then
    if command -v chardetect >/dev/null 2>&1; then
      enc=$(chardetect "$f" 2>/dev/null | sed 's/^[^:]*: //; s/ with confidence.*//')
      case "${enc,,}" in
        gb2312|gbk) enc=gb18030 ;;
        windows-*|iso8859*|iso-8859*|ascii|utf-8|none|"") enc="" ;;   # not plausible for CJK
      esac
      if [[ -n "$enc" ]] && iconv -f "$enc" -t utf-8 "$f" >/dev/null 2>&1; then
        echo "$enc"; return
      fi
    fi
    for enc in gb18030 big5 shift_jis euc-kr; do
      if iconv -f "$enc" -t utf-8 "$f" >/dev/null 2>&1; then echo "$enc"; return; fi
    done
  fi
  echo windows-1252
}

tmpraw="$(mktemp)"
tmpin="$(mktemp)"
trap 'rm -f "${tmpraw}" "${tmpin}"' EXIT

enc="$(detect_encoding "${infile}")"
[[ "${enc,,}" != "utf-8" ]] && echo "Input encoding detected: ${enc}" >&2
if ! iconv -f "${enc}" -t UTF-8 "${infile}" > "${tmpraw}" 2>/dev/null; then
  echo "Warning: invalid ${enc} bytes were dropped during conversion" >&2
  iconv -c -f "${enc}" -t UTF-8 "${infile}" > "${tmpraw}" 2>/dev/null
fi
sed -e '1s/^\xEF\xBB\xBF//' -e 's/\r$//' "${tmpraw}" > "${tmpin}"

awk -F'\t' -v SUBDELIM=";" '
BEGIN { OFS=""; SEP="\034"; SF="\035"
  # SF is an internal marker used by sf(); it is replaced by OUTSF on output.
  # OUTSF must match the delimiter used in your own mappings ("^_a" etc.).
  # Use "\037" instead if text2marc expects the real 0x1f character.
  OUTSF="^_"
  # ISBD punctuation table. punct[tag,code] = text appended to the PREVIOUS
  # subfield when subfield <code> follows it; endp[tag] = closing punctuation
  # for the last subfield. Add rows for other tags as needed.
  punct["264","b"] = " :"; punct["264","c"] = ","
  endp["264"] = "."
}

# -------------------------------------------------
# HEADER NORMALIZATION
# -------------------------------------------------
function normalize(s) {
  s = tolower(s)
  gsub(/[áàâä]/, "a", s)
  gsub(/[éèêë]/, "e", s)
  gsub(/[íìîï]/, "i", s)
  gsub(/[óòôö]/, "o", s)
  gsub(/[úùûü]/, "u", s)
  gsub(/ç/, "c", s)
  gsub(/ñ/, "n", s)
  gsub(/[^a-z0-9]/, "", s)
  return s
}

# -------------------------------------------------
# INDICATOR NORMALIZATION
# -------------------------------------------------
function norm_ind(ind,   i) {
  ind = sprintf("%-2s", ind)
  for (i = 1; i <= 2; i++)
    if (substr(ind, i, 1) == "_")
      ind = substr(ind, 1, i-1) " " substr(ind, i+1)
  return ind
}

# -------------------------------------------------
# MARC OUTPUT HELPERS
# -------------------------------------------------
# If val comes from vall(), it contains SEP-separated values: the text before
# the first SEP is the prefix (e.g. "a"), and one field is printed per value.
function emit(tag, ind, s) {
  gsub(SF, OUTSF, s)
  print "=", tag, "  ", ind, s
}

function marc(tag, ind, val,   p, n, a, i, prefix) {
  # skip empty values, and a bare prefix such as "^_a" with nothing after it
  if (val == "" || val ~ /^\^_[a-z0-9]$/) return
  ind = norm_ind(ind)
  p = index(val, SEP)
  if (p == 0) {
    emit(tag, ind, val)
    return
  }
  prefix = substr(val, 1, p-1)
  n = split(substr(val, p+1), a, SEP)
  for (i = 1; i <= n; i++)
    emit(tag, ind, prefix a[i])
}

# sf("a", value) returns the subfield (delimiter + code + value), or "" when
# the value is empty, so blank subfields are dropped and a field whose
# subfields are all blank is not printed at all. Combine several in one call:
#   marc("541", "__", sf("a", v("f1")) sf("b", v("f2")) sf("c", v("f3")))
function sf(code, val) {
  return (val == "") ? "" : SF code val
}

# marc_isbd() works like marc() for a value built with sf(), but adds ISBD
# punctuation from the table in BEGIN. Punctuation is only added between
# subfields that are actually present, and never doubled if the value already
# ends with that character.
function marc_isbd(tag, ind, val,   n, a, i, t, nxt, p, out) {
  if (val == "") return
  n = split(val, a, SF)              # a[1] is empty (text before first SF)
  for (i = 2; i <= n; i++) {
    t = a[i]
    if (i < n) p = punct[tag, substr(a[i+1], 1, 1)]
    else       p = endp[tag]
    if (p != "" && substr(t, length(t)) != substr(p, length(p)))
      t = t p
    out = out SF t
  }
  marc(tag, ind, out)
}

function ctrl(tag, val) {
  if (val == "") return
  print "=", tag, "  ", val
}

function repeat_marc(tag, ind, val,   n,i,a) {
  if (val == "") return
  ind = norm_ind(ind)
  n = split(val, a, / *, */)
  for (i = 1; i <= n; i++)
    if (a[i] != "")
      print "=", tag, "  ", ind, "a" a[i]
}

function repeat_marc_subdelim(tag, ind, val, delim,   n,i,a,regex) {
  if (val == "") return
  ind = norm_ind(ind)
  regex = "[[:space:]]*" delim "[[:space:]]*"
  n = split(val, a, regex)
  for (i = 1; i <= n; i++)
    if (a[i] != "")
      print "=", tag, "  ", ind, "a" a[i]
}

# -------------------------------------------------
# FIXED FIELD HELPERS
# -------------------------------------------------
function extract_year(s) {
  if (match(s, /[0-9]{4}/))
    return substr(s, RSTART, 4)
  return "####"
}

function today_ymd() {
  return strftime("%y%m%d")
}

function lang_code(v) {
  v = normalize(v)
  if (v ~ /^fr/) return "fre"
  if (v ~ /^en/) return "eng"
  if (v ~ /^ch/) return "chi"
  return "|||"
}

function leader_from(has_serial) {
  return has_serial \
    ? "00000nab a2200000   4500" \
    : "00000nam a2200000   4500"
}

function field_008(date_val, place_val, lang_val,   y) {
  y = extract_year(date_val)
  return today_ymd() "s" y "    fr ||||  ||||    0 0 " lang_code(lang_val) " d"
}

# -------------------------------------------------
# HEADER MAP
# -------------------------------------------------
NR == 1 {
  for (i = 1; i <= NF; i++)
    h[ normalize($i) ] = i
  next
}

# v("a|b|c") returns the value of the first listed column that exists in
# the header AND is non-empty. Each alternative is normalized, so
# v("Titre périodique|Serial title") works as well as v("titreperiodique").
function v(k,   parts, n, i, key) {
  n = split(k, parts, "[|]")
  for (i = 1; i <= n; i++) {
    key = normalize(parts[i])
    if ((key in h) && $(h[key]) != "")
      return $(h[key])
  }
  return ""
}

# vall("a|b|c") returns ALL non-empty, distinct values from the listed columns.
# Use it with marc() to emit one repeated field per value:
#   marc("650", " 4", "a" vall("subj1|subj2"))
function vall(k,   parts, n, i, key, val, out, seen) {
  n = split(k, parts, "[|]")
  for (i = 1; i <= n; i++) {
    key = normalize(parts[i])
    if (!(key in h)) continue
    val = $(h[key])
    if (val == "" || (val in seen)) continue
    seen[val] = 1
    out = out SEP val
  }
  return (out == "") ? SEP : out
}

# -------------------------------------------------
# RECORD
# -------------------------------------------------
{
  has_serial = (v("titreperiodique") != "")

  ctrl("LDR", leader_from(has_serial))
  ctrl("001", v("ftcid"))
  ctrl("006", "m        d")
  ctrl("008", field_008(v("date"), "", v("lang|language")))
  marc("020", " ", "^_a" v("isbn"))
  marc("050", " ", "^_a" v("callnumber|call"))

  marc("100", "1 ", "^_a" v("author"))
  marc("245", "10", "^_a" v("title|maintitle|nameofthebook"))
  marc_isbd("264", " 1", sf("a", v("cityofpublication")) sf("b", v("publisher")) sf("c", v("date|yearofpublication")))
  marc("300", "  ", "^_a" v("pages"))
  marc("520", "  ", "^_a" v("abstract|aboutthebook"))

  repeat_marc("650", " 4", v("subject"))
  repeat_marc_subdelim("650", " 4", v("subject"), ";")

  print ""
}
' "${tmpin}" > "${outfile}"
text2marc "${outfile}"
rm -f "${outfile}"
